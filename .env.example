# ── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# Backend API base URL
# Leave empty (or omit) when frontend and backend are on the same origin (production)
# Set to http://localhost:8080 for local development when running separately
VITE_API_BASE_URL=http://localhost:8080

# Cloudflare Turnstile site key (public — safe to commit)
# Use "1x00000000000000000000AA" for local testing (always passes)
# Get a real key at https://dash.cloudflare.com → Turnstile
VITE_CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# ── Backend environment variables (set in Render / shell) ────────────────────
# These are NOT frontend env vars — set them in your deployment platform
# or in backend/src/main/resources/application-local.properties (gitignored).

# DB_HOST=aws-0-eu-west-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<your-supabase-password>

# Cloudflare Turnstile secret key (server-side, keep private)
# Use "1x0000000000000000000000000000000AA" for local testing (always passes)
# CF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
